{
  "name": "mokkan",
  "version": "0.1.0",
  "private": true,
  "description": "標準のmdファイル群をデータベースにした、個人用のタスク管理デスクトップアプリ",
  "main": "./out/main/index.js",
  "author": "kanjiyamamoto66",
  "license": "MIT",
  "homepage": "https://github.com/kanjiyamamoto66/mokkan",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "sandbox": "node scripts/make-sandbox.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fullcalendar/react": "^7.1.3",
    "@milkdown/kit": "^7.22.3",
    "@svar-ui/react-gantt": "^2.8.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "mdast-util-gfm-table": "^2.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "temporal-polyfill": "^1.0.6",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
